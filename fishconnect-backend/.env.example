# Local DBngin PostgreSQL connection. DBngin commonly uses the default 5432 port.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=fishconnect_db
PGUSER=postgres
PGPASSWORD=your_local_postgres_password
PGSSL=false

# For Supabase, use its PostgreSQL connection string and set PGSSL=true.
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
